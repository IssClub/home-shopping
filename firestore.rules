rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // רק בני הבית. החליפו את האימיילים באימיילים של המשתמשים שיצרתם ב-Authentication.
    function isHousehold() {
      return request.auth != null
        && request.auth.token.email_verified in [true, false]
        && request.auth.token.email in ['REPLACE_WITH_HOUSEHOLD_EMAIL@example.com'];
    }
    match /{document=**} { allow read, write: if isHousehold(); }
  }
}
